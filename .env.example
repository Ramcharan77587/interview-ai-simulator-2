# ==============================================================================
# Interview AI Simulator - Environment Configuration Template
# Copy this file to .env and configure values before starting the application
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL
# ==============================================================================

# Database Connection (Neon PostgreSQL or local instance)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication & Token Signing
JWT_SECRET="your_secure_jwt_secret_key_here"

# Web Application & API Ports
PORT=5000
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Python ML Microservice URL (FastAPI running on port 8000)
ML_SERVICE_URL="http://127.0.0.1:8000"

# Google Gemini API Key (Optional: Server provides local heuristic fallbacks if omitted)
GEMINI_API_KEY=""
